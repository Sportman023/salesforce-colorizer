{
  "name": "salesforce-colorizer",
  "displayName": "Salesforce Colorizer",
  "description": "Highlights the VS Code UI when the default Salesforce org matches configured keywords (e.g. Production)",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.97.2"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sportman023/salesforce-colorizer.git"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/.sf/config.json",
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Salesforce Colorizer",
      "properties": {
        "salesforce-colorizer.highlightKeywords": {
          "type": "array",
          "description": "Keywords to identify orgs to highlight (e.g., Production, Important)",
          "default": [
            "Production"
          ],
          "items": {
            "type": "string"
          },
          "scope": "machine-overridable"
        },
        "salesforce-colorizer.workbenchColorCustomizations": {
          "type": "array",
          "description": "Workbench Color Customizations to highlight (e.g., statusBar.background) Full list of properties: https://code.visualstudio.com/api/references/theme-color",
          "default": [
            "statusBar.background",
            "menu.selectionBackground",
            "quickInput.list.focusBackground"
          ],
          "items": {
            "type": "string"
          },
          "scope": "machine-overridable"
        },
        "salesforce-colorizer.highlightColor": {
          "type": "string",
          "description": "Color of highlighted orgs",
          "default": "#570000b2",
          "format": "color",
          "scope": "machine-overridable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "rm -rf out && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build-package": "vsce package",
    "install-extension": "code --install-extension salesforce-colorizer-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.19.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "serialize-javascript": "^7.1.1",
    "diff": "^8.0.3"
  }
}
